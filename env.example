# Twilio ConversationRelay Demo - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==============================================================================
# TWILIO CREDENTIALS
# Get these from: https://console.twilio.com/
# ==============================================================================

# Your Twilio Account SID (starts with "AC")
# Found on Console Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token
# Found on Console Dashboard (click "Show" to reveal)
# SECURITY: Keep this secret. Used for webhook signature validation.
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (E.164 format)
# Purchase from: https://console.twilio.com/us1/develop/phone-numbers/manage/incoming
# Must have Voice capability enabled
TWILIO_PHONE_NUMBER=+15551234567

# ==============================================================================
# OPENAI CREDENTIALS
# Get these from: https://platform.openai.com/api-keys
# ==============================================================================

# OpenAI API key (starts with "sk-")
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI model to use (optional)
# Default: gpt-4o-mini
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# PUBLIC URL (for webhooks)
# ==============================================================================

# Your public URL domain (without https://)
# For local development: Start ngrok with `ngrok http 3000` and copy the domain
# For production: Your deployed app's domain (e.g., myapp.vercel.app)
NGROK_URL=your-subdomain.ngrok.app

# ==============================================================================
# OPTIONAL: DEVELOPMENT SETTINGS
# ==============================================================================

# Port to run the server (default: 3000)
# PORT=3000

# Node environment
# NODE_ENV=development
